{
  "name": "sokoyetu-backend",
  "version": "1.0.0",
  "description": "SokoYetu backend API - Express and PostgreSQL service for the SokoYetu marketplace",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "node src/db/migrate.js",
    "db:verify": "node src/db/migrate.js --verify",
    "test": "node tests/setup-db.js && node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:setup": "node tests/setup-db.js",
    "test:watch": "node --test --test-concurrency=1 --watch \"tests/**/*.test.js\""
  },
  "keywords": [],
  "author": "MujawumukizaBonna",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
