# SokoYetu Backend Environment Variables
# Copy this file, fill in your real values, and save it as .env

# PostgreSQL connection string
# Local development with Docker Compose:
# DATABASE_URL=postgresql://sokoyetu:sokoyetu@localhost:5432/sokoyetu
# DATABASE_SSL=false
#
# Hosted PostgreSQL:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Set this to true only for hosted PostgreSQL providers that require TLS.
DATABASE_SSL=true

# JWT Secret should be a long random string.
JWT_SECRET=sokoyetu_secret_change_this_to_something_long_and_random

# Your frontend URL
# Local development: http://localhost:3000
# Deployment: https://sokoyetu.vercel.app
FRONTEND_URL=http://localhost:3000

# pawaPay sandbox configuration
# Sandbox base URL: https://api.sandbox.pawapay.io
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
PAWAPAY_API_TOKEN=replace_with_your_sandbox_token
PAWAPAY_CALLBACK_URL=http://localhost:5000/api/payments/pawapay/callback/deposit
PAWAPAY_DEFAULT_COUNTRY=RWA
PAWAPAY_DEFAULT_CURRENCY=RWF
PAWAPAY_SIGNED_REQUESTS_ENABLED=false
PAWAPAY_SIGNED_CALLBACKS_ENABLED=false
PAWAPAY_PUBLIC_KEY_ID=

# Port (Railway sets this automatically)
PORT=5000
